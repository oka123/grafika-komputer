<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue_surface"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Algoritma Garis DDA dan Bresenham"
            android:textColor="@color/blue_primary_variant"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Input Control Panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_marginBottom="10dp">

        <!-- Coordinate Input Fields -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/edtX1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="X1"
                android:inputType="number|numberSigned"
                android:layout_marginEnd="6dp"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/edtY1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Y1"
                android:inputType="number|numberSigned"
                android:layout_marginEnd="6dp"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/edtX2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="X2"
                android:inputType="number|numberSigned"
                android:layout_marginEnd="6dp"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/edtY2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Y2"
                android:inputType="number|numberSigned"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Algorithm Selection Radio Group with Color Indicators -->
        <RadioGroup
            android:id="@+id/rgAlgoritma"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <RadioButton
                android:id="@+id/rbDDA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DDA (Biru)"
                android:textColor="@color/line_dda"
                android:textStyle="bold"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rbBresenham"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bresenham (Merah)"
                android:textColor="@color/line_bresenham"
                android:textStyle="bold"
                android:layout_marginStart="20dp" />
        </RadioGroup>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnGambar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="Gambar Garis"
                android:backgroundTint="@color/blue_primary"
                android:textColor="@color/white"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnBersihkan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Bersihkan"
                android:backgroundTint="@color/blue_light_accent"
                android:textColor="@color/blue_primary_variant" />
        </LinearLayout>
    </LinearLayout>

    <!-- Canvas Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_canvas"
        android:clipToOutline="true">

        <com.example.grafikakomputer.CanvasGarisView
            android:id="@+id/canvasGarisView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF" />

        <!-- Hint Zoom / Gesture Overlay -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:background="#AAFFFFFF"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="Cubit untuk zoom • Geser untuk pan • Double tap reset"
            android:textColor="@color/axis_color"
            android:textSize="10sp" />
    </FrameLayout>

</LinearLayout>
